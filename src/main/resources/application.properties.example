spring.application.name=movie_reservation
spring.datasource.url=<Your_Database_Url>
spring.datasource.username=<Your_Database_Username>
spring.datasource.password=<Your_Database_Password>
jwt.secret=<Your_Secret_Key>
jwt.expiration-ms=<Expire_Time>
spring.data.redis.host=
spring.data.redis.port=
spring.data.redis.password=
spring.data.redis.database=
order.expire-scan-delay-ms=60000
order.expire-scan-initial-delay-ms=10000
payment.mock.callback-secret=

# Redis admission control for order creation (defaults also apply if omitted).
order.redis.enabled=true
order.redis.request-lock-ttl=60s
order.redis.rate-limit-window=10s
order.redis.rate-limit-max-requests=3
spring.data.redis.connect-timeout=1s
spring.data.redis.timeout=1s
