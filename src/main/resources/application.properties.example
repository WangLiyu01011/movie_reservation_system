spring.application.name=movie_reservation
spring.datasource.url=${MYSQL_URL:jdbc:mysql://127.0.0.1:3306/movie_db?createDatabaseIfNotExist=true&useUnicode=true&allowPublicKeyRetrieval=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false}
spring.datasource.username=${MYSQL_USERNAME:root}
spring.datasource.password=${MYSQL_PASSWORD}
# Every new pooled connection (including Flyway) uses Shanghai civil time.
spring.datasource.hikari.connection-init-sql=SET SESSION time_zone = '+08:00'
# New databases start at B1; existing databases retain their V1 migration history.
spring.jpa.hibernate.ddl-auto=validate
jwt.secret=${JWT_SECRET}
jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}
spring.data.redis.host=${REDIS_HOST:127.0.0.1}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}
spring.data.redis.database=${REDIS_DATABASE:0}
order.expire-scan-delay-ms=60000
order.expire-scan-initial-delay-ms=10000
payment.mock.callback-secret=${PAYMENT_MOCK_CALLBACK_SECRET}
payment.mock.checkout-base-url=${PAYMENT_MOCK_CHECKOUT_BASE_URL:http://localhost:8080/api/v1/mock-payments}

order.redis.enabled=true
order.redis.request-lock-ttl=60s
order.redis.rate-limit-window=10s
order.redis.rate-limit-max-requests=3
order.redis.expire-scan-delay=1s
order.redis.batch-size-for-expiration=20
spring.data.redis.connect-timeout=1s
spring.data.redis.timeout=1s

langchain4j.open-ai.chat-model.api-key=${OPENAI_API_KEY}
langchain4j.open-ai.chat-model.base-url=${OPENAI_BASE_URL:https://api.openai.com/v1}
langchain4j.open-ai.chat-model.model-name=${OPENAI_MODEL:gpt-4o-mini}
